<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
    <module name="controller">
        <param name="lastIteration" value="10" />
        <param name="outputDirectory" value="output" />
        <param name="overwriteFiles" value="deleteDirectoryIfExists" />
        <param name="mobsim" value="hermes" />
        <param name="writeEventsInterval" value="10" />
        <param name="writePlansInterval" value="10" />
        <param name="writeSnapshotsInterval" value="10" />
    </module>
    <module name="global">
        <param name="coordinateSystem" value="EPSG:26915" />
        <param name="numberOfThreads" value="30" />
    </module>
    <module name="linkStats">
        <param name="averageLinkStatsOverIterations" value="5" />
        <param name="writeLinkStatsInterval" value="10" />
    </module>
    <module name="counts">
        <param name="inputCountsFile" value="counts.xml" />
        <param name="countsScaleFactor" value="6.666666666666667" />
        <param name="outputformat" value="all" />
        <param name="averageCountsOverIterations" value="10" />
        <param name="writeCountsInterval" value="10" />
    </module>
    <module name="network">
        <param name="inputNetworkFile" value="network.xml" />
    </module>
    <module name="plans">
        <param name="inputPlansFile" value="plans.xml" />
    </module>
    <module name="qsim">
        <param name="flowCapacityFactor" value="0.15" />
        <param name="endTime" value="36:00:00" />
        <param name="storageCapacityFactor" value="0.18" />
        <param name="numberOfThreads" value="30" />
        <param name="stuckTime" value="10.0" />
    </module>
    <module name="hermes">
        <param name="flowCapacityFactor" value="0.15" />
        <param name="storageCapacityFactor" value="0.18" />
        <param name="endTime" value="36:00:00" />
    </module>
    <module name="replanning">
        <param name="fractionOfIterationsToDisableInnovation" value="0.8" />
        <parameterset type="strategysettings">
            <param name="strategyName" value="SelectExpBeta" />
            <param name="weight" value="0.6" />
        </parameterset>
        <parameterset type="strategysettings">
            <param name="strategyName" value="ReRoute" />
            <param name="weight" value="0.2" />
        </parameterset>
        <parameterset type="strategysettings">
            <param name="strategyName" value="TimeAllocationMutator" />
            <param name="weight" value="0.1" />
        </parameterset>
        <parameterset type="strategysettings">
            <param name="strategyName" value="SubtourModeChoice" />
            <param name="weight" value="0.1" />
        </parameterset>
        <parameterset type="strategysettings">
            <param name="strategyName" value="ChangeExpBeta" />
            <param name="weight" value="0.8" />
            <param name="subpopulation" value="freight" />
        </parameterset>
        <parameterset type="strategysettings">
            <param name="strategyName" value="ReRoute" />
            <param name="weight" value="0.2" />
            <param name="subpopulation" value="freight" />
        </parameterset>
    </module>
    <module name="subtourModeChoice">
        <param name="modes" value="car,pt,walk" />
        <param name="chainBasedModes" value="car" />
        <param name="considerCarAvailability" value="true" />
    </module>
    <module name="scoring">
        <param name="fractionOfIterationsToStartScoreMSA" value="0.8" />
        <parameterset type="scoringParameters">
            <parameterset type="activityParams">
                <param name="activityType" value="Dining" />
                <param name="typicalDuration" value="00:31:35" />
                <param name="typicalDurationScoreComputation" value="relative" />
                <param name="priority" value="1.0" />
                <param name="scoringThisActivityAtAll" value="true" />
                <param name="openingTime" value="08:28:00" />
                <param name="closingTime" value="20:56:00" />
                <param name="minimalDuration" value="00:05:07" />
            </parameterset>
            <parameterset type="activityParams">
                <param name="activityType" value="Home" />
                <param name="typicalDuration" value="12:00:00" />
                <param name="typicalDurationScoreComputation" value="relative" />
                <param name="priority" value="1.0" />
                <param name="scoringThisActivityAtAll" value="true" />
            </parameterset>
            <parameterset type="activityParams">
                <param name="activityType" value="Other" />
                <param name="typicalDuration" value="01:01:00" />
                <param name="typicalDurationScoreComputation" value="relative" />
                <param name="priority" value="1.0" />
                <param name="scoringThisActivityAtAll" value="true" />
                <param name="openingTime" value="08:49:00" />
                <param name="closingTime" value="21:38:37" />
                <param name="minimalDuration" value="00:06:00" />
            </parameterset>
            <parameterset type="activityParams">
                <param name="activityType" value="School" />
                <param name="typicalDuration" value="06:55:00" />
                <param name="typicalDurationScoreComputation" value="relative" />
                <param name="priority" value="1.0" />
                <param name="scoringThisActivityAtAll" value="true" />
                <param name="openingTime" value="07:10:00" />
                <param name="closingTime" value="17:41:49" />
                <param name="minimalDuration" value="00:42:09" />
            </parameterset>
            <parameterset type="activityParams">
                <param name="activityType" value="Shopping" />
                <param name="typicalDuration" value="00:18:34" />
                <param name="typicalDurationScoreComputation" value="relative" />
                <param name="priority" value="1.0" />
                <param name="scoringThisActivityAtAll" value="true" />
                <param name="openingTime" value="08:10:00" />
                <param name="closingTime" value="19:58:06" />
                <param name="minimalDuration" value="00:04:38" />
            </parameterset>
            <parameterset type="activityParams">
                <param name="activityType" value="Social" />
                <param name="typicalDuration" value="01:20:00" />
                <param name="typicalDurationScoreComputation" value="relative" />
                <param name="priority" value="1.0" />
                <param name="scoringThisActivityAtAll" value="true" />
                <param name="openingTime" value="06:19:00" />
                <param name="closingTime" value="21:45:00" />
                <param name="minimalDuration" value="00:16:59" />
            </parameterset>
            <parameterset type="activityParams">
                <param name="activityType" value="Work" />
                <param name="typicalDuration" value="05:14:00" />
                <param name="typicalDurationScoreComputation" value="relative" />
                <param name="priority" value="1.0" />
                <param name="scoringThisActivityAtAll" value="true" />
                <param name="openingTime" value="06:00:00" />
                <param name="closingTime" value="21:00:00" />
                <param name="minimalDuration" value="00:17:51" />
            </parameterset>
            <parameterset type="activityParams">
                <param name="activityType" value="freight_origin" />
                <param name="typicalDuration" value="00:30:00" />
                <param name="scoringThisActivityAtAll" value="false" />
            </parameterset>
            <parameterset type="activityParams">
                <param name="activityType" value="freight_destination" />
                <param name="typicalDuration" value="00:30:00" />
                <param name="scoringThisActivityAtAll" value="false" />
            </parameterset>
            <parameterset type="modeParams">
                <param name="mode" value="car" />
            </parameterset>
            <parameterset type="modeParams">
                <param name="mode" value="pt" />
            </parameterset>
            <parameterset type="modeParams">
                <param name="mode" value="walk" />
                <param name="constant" value="-1.0" />
            </parameterset>
            <param name="waitingPt" value="-3.0" />
        </parameterset>
    </module>
    <module name="transitRouter">
        <param name="additionalTransferTime" value="0.0" />
        <param name="directWalkFactor" value="1.3" />
        <param name="extensionRadius" value="200.0" />
        <param name="maxBeelineWalkConnectionDistance" value="250.0" />
        <param name="searchRadius" value="1000.0" />
    </module>
    <module name="transit">
        <param name="useTransit" value="true" />
        <param name="transitScheduleFile" value="transitSchedule.xml" />
        <param name="vehiclesFile" value="transitVehicles.xml" />
        <param name="transitModes" value="pt" />
    </module>
</config>